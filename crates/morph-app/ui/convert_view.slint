// SPDX-License-Identifier: GPL-3.0-or-later
// Conversion window, options page (SPEC §3.2): `ConvertView`, shown by
// main.slint when `page == 0`.
// Data and callbacks: the `ConvertUi` global (Rust: `controller.rs`). Text:
// the `Strings` global (Rust: `src/convert_text.rs`, `src/strings/mod.rs`).
// No user-visible strings here.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView, Slider, SpinBox } from "std-widgets.slint";
import { Card, SubtleCard, SegmentedBar, FormatChip, FormatChipGrid, CategoryBadge, CategoryTabCard, IconButton, Pill, WarningBanner } from "widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";

export struct FileRow {
    name: string,
    folder: string,
    size: string,
}

// A file no tab takes, with the reason ("This file type isn't supported.").
export struct SkippedFile {
    name: string,
    reason: string,
}

export struct FormatInfo {
    label: string,
    lossy: bool,
    lossless-mode: bool,
    alpha: bool,
    default-quality: int,
    is-ico: bool,
    // "PDF" target: Image → PDF (page size, margin).
    is-pdf: bool,
}

// One audio output format of the format box (Audio → Convert, Extract audio).
export struct AudioFormatInfo {
    label: string,
    lossless: bool,
    is-mp3: bool,
    // "192 kbps", …; empty for lossless formats.
    bitrates: [string],
    default-bitrate: int,
}

export struct Toggle {
    label: string,
    checked: bool,
}

// One card of a mixed selection (`ConvertUi.categories`).
export struct CategoryCard {
    // Theme category id: 0 images, 1 PDF, 2 video, 3 audio, 4 documents.
    category: int,
    // "Images (10)".
    label: string,
    // What runs now: "→ WebP", "Compress", "→ PDF".
    summary: string,
    // false = skipped by choice.
    included: bool,
    // Accessible name of the checkbox: "Include Images".
    include-label: string,
}

